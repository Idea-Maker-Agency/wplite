{
	"name": "wplite",
	"version": "1.0.0",
	"scripts": {
		"watch:sass": "sass --load-path=theme/assets/lib/scss --style=compressed --watch --poll theme/assets/lib/scss/main.scss:theme/assets/lib/css/main.min.css theme/templates:theme/templates theme/page-templates:theme/page-templates",
		"watch:templates-sass": "sass --load-path=theme/assets/lib/scss --style=compressed --watch --poll theme/templates:theme/templates",
		"watch:page-templates-sass": "sass --load-path=theme/assets/lib/scss --style=compressed --watch --poll theme/page-templates:theme/page-templates",
		"compile:sass": "sass --load-path=theme/assets/lib/scss --style=compressed theme/assets/lib/scss/main.scss:theme/assets/lib/css/main.min.css theme/assets/lib/scss/templates:theme/assets/lib/css/templates",
		"compile:theme": "npm run compile:sass && cp -r theme wplite && bestzip wplite.zip wplite/*",
		"format": "prettier --write ."
	},
	"dependencies": {
		"bootstrap": "^5.3.3"
	},
	"devDependencies": {
		"bestzip": "^2.2.1",
		"prettier": "^3.6.2",
		"sass": "^1.77.7"
	}
}
