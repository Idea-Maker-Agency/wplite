{
	"name": "wplite",
	"version": "1.0.0",
	"scripts": {
		"watch:sass": "sass --load-path=theme --load-path=node_modules --style=compressed --watch --poll theme/scss/main.scss:theme/assets/css/main.min.css theme/pages:theme/pages theme/page-templates:theme/page-templates theme/components:theme/components",
		"compile:sass": "sass --load-path=theme --load-path=node_modules --style=compressed theme/scss/main.scss:theme/assets/css/main.min.css theme/pages:theme/pages theme/page-templates:theme/page-templates theme/components:theme/components",
		"prezip": "npm run compile:sass && composer install --no-dev --optimize-autoloader --working-dir=theme",
		"zip": "cd theme && npx wp-scripts plugin-zip && mv wplite.zip ../wplite.zip",
		"postzip": "composer install --working-dir=theme",
		"format": "prettier --write ."
	},
	"dependencies": {
		"bootstrap": "^5.3.3"
	},
	"devDependencies": {
		"@wordpress/scripts": "^32.6.0",
		"prettier": "^3.6.2",
		"sass": "^1.77.7"
	}
}
