{
	"name": "wplite",
	"version": "1.0.0",
	"scripts": {
		"watch:sass": "sass --load-path=theme --style=compressed --watch --poll theme/scss/main.scss:theme/assets/css/main.min.css",
		"watch:templates-sass": "sass --load-path=theme --style=compressed --watch --poll theme/templates:theme/templates",
		"watch:page-templates-sass": "sass --load-path=theme --style=compressed --watch --poll theme/page-templates:theme/page-templates",
		"watch:components-sass": "sass --load-path=theme --style=compressed --watch --poll theme/components:theme/components",
		"compile:sass": "sass --load-path=theme --style=compressed theme/scss/main.scss:theme/assets/css/main.min.css theme/templates:theme/templates theme/page-templates:theme/page-templates theme/components:theme/components",
		"compile:theme": "npm run compile:sass && cp -r theme wplite && bestzip wplite.zip wplite/*",
		"format": "prettier --write ."
	},
	"dependencies": {
		"bootstrap": "^5.3.3"
	},
	"devDependencies": {
		"bestzip": "^2.2.1",
		"prettier": "^3.6.2",
		"sass": "^1.77.7"
	}
}
