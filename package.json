{
	"name": "wplite",
	"version": "1.0.0",
	"scripts": {
		"prezip": "composer install --no-dev --optimize-autoloader --working-dir=theme",
		"zip": "cd theme && npx wp-scripts plugin-zip && mv wplite.zip ../wplite.zip",
		"postzip": "composer install --working-dir=theme",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@wordpress/scripts": "^32.6.0"
	}
}
