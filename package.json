{
  "name": "wplite",
  "version": "1.0.0",
  "scripts": {
    "watch:sass": "sass --load-path=theme/assets/lib/scss --style=compressed --watch --poll theme/assets/lib/scss/main.scss:theme/assets/lib/css/main.min.css theme/assets/lib/scss/templates:theme/assets/lib/css/templates",
    "compile:sass": "sass --load-path=theme/assets/lib/scss --style=compressed theme/assets/lib/scss/main.scss:theme/assets/lib/css/main.min.css theme/assets/lib/scss/templates:theme/assets/lib/css/templates",
    "compile:theme": "npm run compile:sass && cp -r theme wplite && bestzip wplite.zip wplite/*"
  },
  "dependencies": {
    "bootstrap": "^5.3.3"
  },
  "devDependencies": {
    "bestzip": "^2.2.1",
    "sass": "^1.77.7"
  }
}
